model Telemetry {
  id        String   @id @default(uuid())
  device_id String
  voltage   Float
  current   Float
  timestamp DateTime @default(now())
}
model User {
  id            String   @id @default(uuid())
  username      String   @unique
  password_hash String
  role          String   @default("viewer") // 'admin' หรือ 'viewer'
  created_at    DateTime @default(now())
}